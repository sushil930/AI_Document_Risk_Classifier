DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
MAX_UPLOAD_MB=20
MAX_DOCUMENT_CHARS=500000
FRONTEND_ORIGIN=http://localhost:5173
GEMINI_API_KEY=replace-with-google-gemini-api-key
GEMINI_TIMEOUT_SECONDS=180
GEMINI_DEFAULT_MODEL=gemini-3.8-flash
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash
GROQ_API_KEY=replace-with-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=180
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b
GROQ_MODELS=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
CLASSIFIER_MODEL_PATH=
CLASSIFIER_ALLOW_CANDIDATE=false
CLASSIFIER_MIN_WORDS=20
